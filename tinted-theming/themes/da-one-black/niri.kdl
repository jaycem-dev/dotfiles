layout {
    background-color "#000000"
    focus-ring {
        active-color   "#6bb8ff"
        inactive-color "#888888"
        urgent-color   "#fa7883"
    }

    border {
        active-color   "#6bb8ff"
        inactive-color "#888888"
        urgent-color   "#fa7883"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#6bb8ff"
        inactive-color "#888888"
        urgent-color   "#fa7883"
    }

    insert-hint {
        color "#8af5ff80"
    }
}

recent-windows {
    highlight {
        active-color "#6bb8ff"
        urgent-color "#fa7883"
    }
}

overview {
    backdrop-color "#000000"
}
