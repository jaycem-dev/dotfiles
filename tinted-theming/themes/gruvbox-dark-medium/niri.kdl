layout {
    background-color "#282828"
    focus-ring {
        active-color   "#83a598"
        inactive-color "#665c54"
        urgent-color   "#fb4934"
    }

    border {
        active-color   "#83a598"
        inactive-color "#665c54"
        urgent-color   "#fb4934"
    }

    shadow {
        color "#28282870"
    }

    tab-indicator {
        active-color   "#83a598"
        inactive-color "#665c54"
        urgent-color   "#fb4934"
    }

    insert-hint {
        color "#8ec07c80"
    }
}

recent-windows {
    highlight {
        active-color "#83a598"
        urgent-color "#fb4934"
    }
}

overview {
    backdrop-color "#282828"
}
