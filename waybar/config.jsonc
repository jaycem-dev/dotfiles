{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 15,

    "modules-center": ["clock"],
    "modules-left": ["niri/workspaces#main", "niri/workspaces#taskbar"],
    "modules-right": [
        "privacy",
        "tray",
        "idle_inhibitor",
        "power-profiles-daemon",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery"
    ],

    "niri/workspaces#main": {
        "format": "{index}"
    },

    "niri/workspaces#taskbar": {
        "current-only": true,
        "workspace-taskbar": {
            "enable": true
        }
    },

    "tray": {
        "spacing": 10
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-critical": "LOW BATTERY {icon} {capacity}%",
        "format-icons": {
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        },
        "states": {
            "critical": 20,
            "warning": 30
        }
    },

    "bluetooth": {
        "format": "󰂯",
        "format-no-controller": "",
        "format-connected": "󰂰",
        "format-off": "󰂲",
        "on-click": "launch-or-focus --tui bluetui"
    },

    "clock": {
        "format": "{:%A, %b %d  %H:%M}"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰛊"
        }
    },

    "network": {
        "format-disconnected": "󰀦",
        "format-ethernet": "󰈀",
        "format-linked": "󱎔",
        "format-wifi": "󰖩",
        "on-click": "launch-or-focus --tui impala",
        "tooltip-format": "Connected to {essid}"
    },

    "power-profiles-daemon": {
        "format-icons": {
            "balanced": "󰾅",
            "default": "󰾅",
            "performance": "󰓅",
            "power-saver": "󰾆"
        }
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"],
            "headphone": "󰋋",
            "headset": "󰋋"
        },
        "format-muted": "󰝟",
        "on-click": "pavucontrol -t 3",
        "on-click-right": "pactl --set-sink-mute 0 toggle"
    }
}
