spawn-at-startup "hypridle"
spawn-at-startup "waybar"
spawn-at-startup "niriusd"
spawn-at-startup "udiskie" "--appindicator"
spawn-at-startup "asahi-fixes"
spawn-at-startup "awww-daemon"

workspace "browser"
workspace "dev"
workspace "media"
workspace "chat"
workspace "gaming"

prefer-no-csd 

output "eDP-1" {
    scale 1.7
}
output "HDMI-A-1" {
    mode "1920x1080@71.910"
    scale 1
}

gestures {
    hot-corners {
        off
    }
}
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
    hide-after-inactive-ms 5000
}

blur {
    offset 5
}

layout {
    gaps 5
    center-focused-column "never" // never, always, on-overflow
    always-center-single-column
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.5
        proportion 0.66667
    }
    preset-window-heights {
        proportion 0.2
        proportion 0.66667
    }
    focus-ring {
        off
        width 2
    }
    border {
        on
        width 2
    }
    tab-indicator {
        width 10
        length total-proportion=1.0
        corner-radius 0
        position "left"
        place-within-column
    }
}

input {
    // warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="30%" // 0% only focus windows that are already fully on screen
    keyboard {
        xkb {
            layout "us"
            variant "colemak_dh_iso"
            options "caps:escape"
        }
    }
    touchpad {
        dwt // disable-while-typing
        natural-scroll
        accel-speed 0.1
    }
}

include "./binds.kdl"
include "./rules.kdl"
include optional=true "./colors.kdl"
