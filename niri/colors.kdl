layout {
    background-color "#1e1e2e"
    focus-ring {
        active-color   "#f5c2e7"
        inactive-color "#45475a"
        urgent-color   "#f38ba8"
    }

    border {
        active-color   "#f5c2e7"
        inactive-color "#45475a"
        urgent-color   "#f38ba8"
    }

    shadow {
        color "#1e1e2e70"
    }

    tab-indicator {
        active-color   "#f5c2e7"
        inactive-color "#45475a"
        urgent-color   "#f38ba8"
    }

    insert-hint {
        color "#94e2d580"
    }
}

recent-windows {
    highlight {
        active-color "#f5c2e7"
        urgent-color "#f38ba8"
    }
}

overview {
    backdrop-color "#1e1e2e"
}
